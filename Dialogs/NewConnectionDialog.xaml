<ui:ContentDialog x:Class="OpenKNX.Toolbox.Dialogs.NewConnectionDialog"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OpenKNX.Toolbox.Dialogs"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:OpenKNX.Toolbox.Converter"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{Binding Title}"
      IsPrimaryButtonEnabled="{Binding CanContinue}"
      PrimaryButtonText="Hinzufügen"
      CloseButtonText="Abbrechen">
    <ui:ContentDialog.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type local:NewConnectionDialog}" />
    </ui:ContentDialog.Resources>

    <StackPanel>
        <ui:TextBox Text="{Binding Name}" PlaceholderText="Name" Margin="2" />
        <ui:TextBox Text="{Binding IpAddress}" PlaceholderText="IP-Adresse" Margin="2" />
        <ui:TextBox Text="{Binding IpPort}" PlaceholderText="IP-Port" Margin="2" />
        <CheckBox Content="Ist TCP" IsChecked="{Binding IsTCP}" Margin="2" />
    </StackPanel>
</ui:ContentDialog>
